{
  "_metadata": {
    "description": "Point-to-point 3-phase bolted fault current calculation",
    "method": "IEEE Point-to-Point Method",
    "standard_references": [
      "IEEE Std 241-1990 (IEEE Recommended Practice for Electric Power Systems in Commercial Buildings)",
      "IEEE Std 242-1986 (IEEE Recommended Practice for Protection and Coordination of Industrial and Commercial Power Systems)"
    ],
    "source_file": "Point-To-Point_Fault_Current_Recreated.xlsx",
    "source_sheet": "Fault Current Calc",
    "formulas": {
      "f": {
        "expression": "f = L \u00d7 I_sc_from \u00d7 1.732 / (C_total \u00d7 V)",
        "description": "Fault current ratio factor. L = feeder length (ft), I_sc_from = available fault current at source (A), 1.732 = sqrt(3) for 3-phase, C_total = total C value (C_per_feeder \u00d7 conductors_per_phase), V = system voltage (V)"
      },
      "M": {
        "expression": "M = 1 / (1 + f)",
        "description": "Multiplier applied to source fault current to get downstream fault current"
      },
      "I_sc_sym_rms": {
        "expression": "I_sc_sym_rms = I_sc_from \u00d7 M",
        "description": "Symmetrical RMS fault current at the downstream end of the feeder (A)"
      },
      "C_total": {
        "expression": "C_total = C_per_feeder \u00d7 conductors_per_phase",
        "description": "Total C value accounts for parallel conductors per phase"
      },
      "C_per_feeder_lookup": {
        "expression": "VLOOKUP(wire_size, C_Table, column_index)",
        "description": "C value per feeder looked up from IEEE table based on wire_size, material (CU/AL), cable_config (Single/3C), and conduit_type (Steel/PVC)",
        "lookup_file": "c_values_lookup.json",
        "lookup_path": "cable[wire_size][material][cable_config][conduit_type]"
      }
    },
    "aic_rating_logic": {
      "description": "AIC rating is determined by the next standard rating above I_sc_sym_rms, with a 95% safety factor applied to each threshold",
      "safety_factor": 0.95,
      "thresholds_A": [
        10000,
        22000,
        42000,
        65000,
        100000,
        150000
      ],
      "rule": "Select lowest threshold T where I_sc_sym_rms < T \u00d7 0.95. If I_sc_sym_rms >= 150000 \u00d7 0.95, value is 'OVER 150K'."
    }
  },
