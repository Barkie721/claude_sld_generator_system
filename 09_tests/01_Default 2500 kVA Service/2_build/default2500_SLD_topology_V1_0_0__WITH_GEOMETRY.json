    "compositor_halts": [
      {
        "id": "HALT-001",
        "topic": "Utility available fault current",
        "text": "COMPOSITOR_HALT: utility available fault current not provided (T3-EOR). No available_fc anywhere in this topology, therefore no A-4 fault-current tags are placed and the DV-4 bus-bracing / AIC check cannot run. Switchboard and panelboard AIC ratings are unset pending this value. Affects sw-201, d-301, r-391, r-392.",
        "nec_reference": "NEC 110.9 / 110.24",
        "blocks": "A-4 tags · DV-4 bus bracing / AIC · switchboard + panelboard AIC ratings"
      },
      {
        "id": "HALT-002",
        "topic": "Utility transformer impedance (%Z, X/R)",
        "text": "COMPOSITOR_HALT: utility transformer impedance (%Z, X/R) is a utility-provided nameplate value. The transformer_impedance data layer covers dry-type distribution units only and has no 2500 kVA row, so pct_z / x_over_r on d-301 are left null rather than fabricated. Affects d-301.",
        "nec_reference": null,
        "blocks": "Fault-current study at the service entrance"
      },
      {
        "id": "HALT-003",
        "topic": "Feeder distances",
        "text": "COMPOSITOR_HALT: feeder distances not provided (T3-EOR). No voltage-drop calculation performed; voltage_drop_pct is absent on every R-1 and no A-5 tags are placed. Affects r-301, r-302, r-303, r-304.",
        "nec_reference": "NEC 210.19(A) IN / 215.2(A)(1) IN",
        "blocks": "Voltage-drop calculation · A-5 tags"
      }
    ],
    "compositor_notes": [
      {
        "id": "NOTE-001",
        "topic": "Service voltage and configuration",
        "text": "480Y/277V, 3 phase 4 wire assumed. Service size (2500 kVA) was the only stated input; voltage and configuration are the Tier-2 defaults for a commercial service of this size.",
        "nec_reference": null
      },
      {
        "id": "NOTE-002",
        "topic": "Occupancy and building levels",
        "text": "Commercial occupancy, 3 storeys on a single normal-power sheet. Levels 1-3 are stated, so A-7 level lines are generated from layout_config.level_order and each riser panel takes its band from level_map.",
        "nec_reference": null
      },
      {
        "id": "NOTE-003",
        "topic": "Distribution section content",
        "text": "One distribution section carrying three feeder breakers (CB-01 400AF/400AT power riser, CB-02 250AF/125AT lighting transformer, CB-03 400AF/400AT mechanical riser). No spares or spaces were requested and none are included.",
        "nec_reference": null
      },
      {
        "id": "NOTE-006",
        "topic": "Riser architecture — depth-1 fans, not cascading chains",
        "text": "Both risers feed levels 2 and 3 directly from the Level-1 panel rather than cascading 1 -> 2 -> 3, matching the golden case. Upper-floor OCPD is internal to the Level-1 panel per its own panel schedule. If the EOR wants a true cascading riser, that is a topology change and layout_config.subfeed_max_depth must be raised past 1.",
        "nec_reference": null
      },
      {
        "id": "NOTE-007",
        "topic": "Riser panel sizing",
        "text": "4P-1-A and 4M-1-A at 400 A MLO; levels 2 and 3 at 225 A MLO on both risers. Feeder sizes are taken from feeder_schedule_V1_0_0.json — tag 4004 (2 sets, 3\" C, (4)350 AL + #3 CU) for the 400 A base feeds, tag 2254 (1 set, 3 1/2\" C, (4)350 AL + #6 CU) for all four 225 A riser legs. No connected-load schedule was provided, so these are default sizes, not calculated ones.",
        "nec_reference": null
      },
      {
        "id": "NOTE-004",
        "topic": "75 kVA transformer secondary OCPD",
        "text": "250A secondary protection per 3_phase_transformer_feeder_schedule_V1_0_0.json, located in the 2L-1-A panel main. 225A is the EOR-preference alternative. Tap conductors are protected at the panel main per NEC 240.21(C).",
        "nec_reference": "NEC 240.21(C)"
      },
      {
        "id": "NOTE-005",
        "topic": "No fire pump, generator, ATS or SPD",
        "text": "None stated, and none defaulted in — emergency power is an architecture decision, not a Tier-2 default. If a fire pump is added later it must be tapped ahead of the main disconnect per NEC 695.4(B); that is non-negotiable.",
        "nec_reference": "NEC 695.4(B)"
      }
    ]
  },
